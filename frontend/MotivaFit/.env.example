# Vazio usa /api na mesma origem (proxy Vite/Nginx). Valor público definido no build.
VITE_API_BASE_URL=
# Apenas servidor Vite; não é enviado ao navegador.
API_PROXY_TARGET=http://localhost:8080
# Client ID OAuth 2.0 do Google (o mesmo de GOOGLE_CLIENT_ID no backend). Vazio oculta o botão "Entrar com Google".
VITE_GOOGLE_CLIENT_ID=
