digraph G { graph [fontname="DejaVu Sans", bgcolor="white", rankdir=TB, nodesep=0.35, ranksep=0.45]; node [shape=box, style="rounded,filled", fillcolor="#edf3fa", fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9]; node [shape=record,style=filled];u [label="{USUARIO|PK id; UQ email|perfil; senha_hash; ativo}"];c [label="{CATALOGO_EXERCICIO|PK id; nome; modalidade|grupo_muscular; ativo}"];t [label="{TREINO|PK id; FK usuario_id|nome; tipo; visibilidade; excluido_em}"];e [label="{EXERCICIO (planejado)|PK id; FK treino_id; FK catalogo_id|meta_carga_kg; meta_repeticoes; meta_series|meta_tempo_s; meta_distancia_m; excluido_em}"];r [label="{REGISTRO_DIARIO|PK id; FK usuario_id; FK catalogo_id|FK treino_id?; FK exercicio_id?|carga_kg; repeticoes; series; tempo_s; distancia_m|executado_em; snapshots; chave_idempotencia}"];pr [label="{RECORDE_PESSOAL (Sprint 8)|PK id; FK usuario_id; FK catalogo_id|metrica; valor; unidade; distancia_referencia_m?|FK registro_origem_id; atingido_em|UQ usuario/catalogo/metrica/referencia}"];cd [label="{CONQUISTA_DEFINICAO (Sprint 9)|PK id; UQ codigo; titulo|tipo_criterio; limiar; versao}"];uc [label="{USUARIO_CONQUISTA (Sprint 9)|PK id; FK usuario_id; FK conquista_id|concedida_em; FK registro_origem_id?|UQ usuario/conquista}"];u->t [label="1 : N"];t->e [label="1 : N"];c->e [label="1 : N"];u->r [label="1 : N"];c->r [label="1 : N"];e->r [label="0..1 : N; SET NULL"];t->r [label="0..1 : N; SET NULL"];u->pr [label="1 : N"];c->pr [label="1 : N"];r->pr [label="origem"];u->uc [label="1 : N"];cd->uc [label="1 : N"];}