digraph G { graph [fontname="DejaVu Sans", bgcolor="white", rankdir=TB, nodesep=0.35, ranksep=0.45]; node [shape=box, style="rounded,filled", fillcolor="#edf3fa", fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9]; node [shape=record,style=filled];u [label="{USUARIO|PK id}"];am [label="{AMIZADE|FK usuario_a|FK usuario_b|estado|UQ par canônico|a != b}"];de [label="{DESAFIO|PK id|FK criador_id|prazo|estado}"];di [label="{DESAFIO_ITEM|PK id|FK desafio_id|FK catalogo_id|metas numéricas}"];dp [label="{DESAFIO_\nPARTICIPANTE|PK/FK desafio_id + usuario_id|estado|aceito_em}"];gr [label="{GRUPO_\nTREINO|PK id|FK dono_id|nome}"];gm [label="{GRUPO_MEMBRO|PK/FK grupo_id + usuario_id|papel|entrou_em}"];cg [label="{CONVITE_\nGRUPO|PK id|FK grupo_id|FK convidador_id|FK destinatario_id|token_hash|expira_em|estado}"];ca [label="{CONVITE_ADMIN|PK id|FK convidador_id|email|token_hash|expira_em|estado}"];pu [label="{PUBLICACAO|PK id|FK autor_id|FK grupo_id?|conteudo|visibilidade|criada_em}"];cu [label="{CURTIDA|PK/FK publicacao_id + usuario_id}"];co [label="{COMENTARIO|PK id|FK publicacao_id|FK autor_id|texto|criado_em|atualizado_em}"];u->am [label="1 : N (ambas FKs)"];u->de [label="1 : N"];de->di [label="1 : N"];de->dp [label="1 : N"];u->dp [label="1 : N"];u->gr [label="1 : N"];gr->gm [label="1 : N"];u->gm [label="1 : N"];gr->cg [label="1 : N"];u->cg [label="autor/destinatário"];u->ca [label="convidador"];gr->pu [label="0..1 : N"];u->pu [label="1 : N"];pu->cu [label="1 : N"];u->cu [label="1 : N"];pu->co [label="1 : N"];u->co [label="1 : N"];}