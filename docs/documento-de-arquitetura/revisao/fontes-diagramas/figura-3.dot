digraph G { graph [fontname="DejaVu Sans", bgcolor="white", rankdir=TB, nodesep=0.35, ranksep=0.45]; node [shape=box, style="rounded,filled", fillcolor="#edf3fa", fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9]; start [shape=oval,label="POST registro / idempotência"];auth [shape=diamond,label="Token e conta válidos?"];valid [shape=diamond,label="Posse e campos válidos?"];err1 [label="401 / 403"];err2 [label="400 / 403"];reg [label="Orquestrador → Registro\nPersistir execução"];rec [label="Registro: atualizar recordes\nRF-20 a partir da Sprint 8"];gam [label="Orquestrador → Gamificação\nRF-22 a partir da Sprint 9"];read [label="Gamificação → porta de Registro\nConsultar dias distintos / assiduidade"];grant [label="Conceder/revalidar conquista\nUQ usuário + definição"];commit [label="Commit da transação e resposta\nFalha: rollback"];start->auth;auth->err1 [label="não"];auth->valid [label="sim"];valid->err2 [label="não"];valid->reg [label="sim"];reg->rec->gam->read->grant->commit;}